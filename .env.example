# Environment
NODE_ENV=development

# Server
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:1825@localhost:5432/tutor_support_db?schema=public"

# JWT Secret (Thay bằng key mạnh hơn trong production)
JWT_SECRET=tutor-support-project-secret-for-dev-only

# ============================================
# EXTERNAL APIs - HCMUT Infrastructure
# ============================================
# Hiện tại: MOCK implementation để development
# Production: Thay bằng URL và API Keys thật từ phòng IT HCMUT

# HCMUT_SSO - Xác thực tập trung (Single Sign-On)
HCMUT_SSO_URL=https://sso.hcmut.edu.vn/api
HCMUT_SSO_API_KEY=mock_sso_api_key_replace_in_production

# HCMUT_DATACORE - Đồng bộ dữ liệu người dùng
HCMUT_DATACORE_URL=https://datacore.hcmut.edu.vn/api
HCMUT_DATACORE_API_KEY=mock_datacore_api_key_replace_in_production

# HCMUT_LIBRARY - Thư viện điện tử
HCMUT_LIBRARY_URL=https://library.hcmut.edu.vn/api
HCMUT_LIBRARY_API_KEY=mock_library_api_key_replace_in_production
