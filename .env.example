# Environment
NODE_ENV=development

# Server
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:1825@localhost:5432/tutor_support_db?schema=public"

# JWT Secret (Thay bằng key mạnh hơn trong production)
JWT_SECRET=tutor-support-project-secret-for-dev-only

# External API URLs (Mô phỏng)
HCMUT_SSO_URL=https://sso.hcmut.edu.vn
